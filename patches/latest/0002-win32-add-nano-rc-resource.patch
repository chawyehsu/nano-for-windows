diff --git a/src/nano.rc b/src/nano.rc
new file mode 100644
index 0000000..2203fb3
--- /dev/null
+++ b/src/nano.rc
@@ -0,0 +1,46 @@
+// Resource script for nano.exe: the application icon and the version
+// information shown by the Windows file properties dialog.
+
+#include <winver.h>
+
+// Passed on the windres command line by src/Makefile.am, which splits them out
+// of automake's $(VERSION).
+#define STRINGIZE_(x)  #x
+#define STRINGIZE(x)   STRINGIZE_(x)
+#define VER_COMMA  NANO_MAJOR, NANO_MINOR, NANO_PATCH, 0
+#define VER_STRING \
+	STRINGIZE(NANO_MAJOR) "." STRINGIZE(NANO_MINOR) "." STRINGIZE(NANO_PATCH)
+
+101 ICON "nano.ico"
+
+VS_VERSION_INFO VERSIONINFO
+ FILEVERSION    VER_COMMA
+ PRODUCTVERSION VER_COMMA
+ FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
+ FILEFLAGS      0x0L
+ FILEOS         VOS_NT_WINDOWS32
+ FILETYPE       VFT_APP
+ FILESUBTYPE    VFT2_UNKNOWN
+BEGIN
+	BLOCK "StringFileInfo"
+	BEGIN
+		// 0x0409: language is U.S. English; 0x04B0: code page is 1200, UTF-16.
+		BLOCK "040904B0"
+		BEGIN
+			VALUE "CompanyName",      L"Chawye Hsu"
+			VALUE "FileDescription",  L"GNU nano for Windows"
+			VALUE "FileVersion",      VER_STRING
+			VALUE "InternalName",     L"nano"
+			VALUE "LegalCopyright",   L"GPL-3.0-or-later"
+			VALUE "OriginalFilename", L"nano.exe"
+			VALUE "ProductName",      L"GNU nano for Windows"
+			VALUE "ProductVersion",   VER_STRING
+			VALUE "Comments",         L"https://github.com/chawyehsu/nano-for-windows"
+		END
+	END
+	BLOCK "VarFileInfo"
+	BEGIN
+		// Must repeat the language and code page of the block above.
+		VALUE "Translation", 0x409, 1200
+	END
+END
-- 
