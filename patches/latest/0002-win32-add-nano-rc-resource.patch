From 429d44fba0b1783809877b3dca3972d2243906e9 Mon Sep 17 00:00:00 2001
From: Chawye Hsu <su+git@chawyehsu.com>
Date: Thu, 22 Oct 2026 22:34:59 +0800
Subject: [PATCH 02/19] win32: add nano rc resource

Embed the application icon and version info via windres. The version
numbers come from automake's $(VERSION), so they follow AC_INIT.

Signed-off-by: Chawye Hsu <su+git@chawyehsu.com>
---
 src/Makefile.am |  19 +++++++++++++++++--
 src/nano.ico    | Bin 0 -> 35492 bytes
 src/nano.rc     |  46 ++++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 63 insertions(+), 2 deletions(-)
 create mode 100644 src/nano.ico
 create mode 100644 src/nano.rc

diff --git a/src/Makefile.am b/src/Makefile.am
index a678e29..228617d 100644
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -1,7 +1,7 @@
 AM_CPPFLAGS = -DLOCALEDIR=\"$(localedir)\" -DSYSCONFDIR=\"$(sysconfdir)\" \
 	-I$(top_builddir)/lib -I$(top_srcdir)/lib
 
-CLEANFILES = revision.h
+CLEANFILES = revision.h nano_rc.$(OBJEXT)
 
 if BUILDING_FROM_GIT
 SOMETHING = "REVISION \"`git describe --tags 2>/dev/null`\""
@@ -43,7 +43,22 @@ nano_SOURCES = \
 		winio.c
 
 nano_LDADD = $(top_builddir)/lib/libgnu.a @LIBINTL@ \
-		$(GETRANDOM_LIB) $(CLOCK_TIME_LIB) $(LIBTHREAD)
+		$(GETRANDOM_LIB) $(CLOCK_TIME_LIB) $(LIBTHREAD) \
+		nano_rc.$(OBJEXT)
+
+# Windows resource: application icon and version info, compiled with windres
+# against the version split out of $(VERSION).
+NANO_VERSION_PARTS = $(subst ., ,$(VERSION))
+NANO_MAJOR = $(word 1,$(NANO_VERSION_PARTS))
+NANO_MINOR = $(or $(word 2,$(NANO_VERSION_PARTS)),0)
+NANO_PATCH = $(or $(word 3,$(NANO_VERSION_PARTS)),0)
+NANO_RC_CPPFLAGS = $(addprefix -DNANO_,MAJOR=$(NANO_MAJOR)) \
+		$(addprefix -DNANO_,MINOR=$(NANO_MINOR)) \
+		$(addprefix -DNANO_,PATCH=$(NANO_PATCH))
+
+nano_rc.$(OBJEXT): $(srcdir)/nano.rc $(srcdir)/nano.ico
+	$(AM_V_GEN)@host_alias@-windres -I$(srcdir) $(NANO_RC_CPPFLAGS) -O coff \
+		-i $(srcdir)/nano.rc -o $@
 
 install-exec-hook:
 	cd $(DESTDIR)$(bindir) && rm -f rnano && $(LN_S) nano rnano
diff --git a/src/nano.ico b/src/nano.ico
new file mode 100644
index 0000000000000000000000000000000000000000..71e9281b4d3e6a5f20f06b81e08ec324582866e5
